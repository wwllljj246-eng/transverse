# 译境 TransVerse 后端环境变量模板
# 复制本文件为 .env 并填入真实值（.env 已加入 .gitignore，绝不提交）

# 腾讯云子账号密钥（建议仅授予 tmt:TextTranslate 权限）
# 获取地址：https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 服务监听端口（默认 8137，与原 start.bat 一致）
PORT=8137

# 腾讯云地域（默认 ap-guangzhou）
TENCENT_REGION=ap-guangzhou

# 每分钟每 IP 最大翻译请求数（默认 12）
RATE_LIMIT=12
